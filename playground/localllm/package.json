{
  "name": "manual-local-llm",
  "private": true,
  "type": "module",
  "description": "A small in-browser language model (jax-js, WebGPU) for the manuals' playgrounds, adapted from jax-js.com/chat (MIT).",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=local-llm.js"
  },
  "dependencies": {
    "@jax-js/jax": "0.1.27",
    "@jax-js/loaders": "0.1.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
